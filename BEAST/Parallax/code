

🎨 How to Use:
-------------------------With text overlay------------------------

<section class="parallax-section with-overlay">
    <div class="parallax-bg">
        <div class="parallax-layer" data-speed="0.3" style="background-image: url('bg.jpg');"></div>
        <div class="parallax-layer" data-speed="0.6" style="background-image: url('fg.png');"></div>
    </div>
    <div class="parallax-content">
        <h2>Your Title</h2>
        <p>Your text</p>
    </div>
</section>

--------------------------------------Without text-----------------
  <section class="parallax-section">
    <div class="parallax-bg">
        <div class="parallax-layer" data-speed="0.4" style="background-image: url('layer.jpg');"></div>
    </div>
</section>
